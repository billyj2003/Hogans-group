// Prisma schema for the Hogan Group delivery portal: customer accounts,
// portal users (customers + staff/admin), and job/delivery (wagon) tracking.
//
// A Job is the overall ask for a site (account, material, total tonnage
// needed). A Delivery is one wagon/load sent against that Job — its own
// driver, vehicle, status lifecycle, live GPS tracking, and POD. A Job can
// have as many Deliveries as it takes to cover the total tonnage.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  DRIVER
}

enum JobStatus {
  OPEN
  COMPLETE
  CANCELLED
}

enum DeliveryStatus {
  ORDERED
  DISPATCHED
  ON_SITE
  UNLOADING
  DELIVERED
  CANCELLED
}

enum MaterialCategory {
  AGGREGATES
  ASPHALT
  CONCRETE
  OTHER
}

model Account {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  siteNotes String?
  createdAt DateTime @default(now())

  users User[]
  jobs  Job[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  driverDeliveries Delivery[] @relation("DriverDeliveries")
}

model Job {
  id            String           @id @default(cuid())
  orderNumber   Int              @unique @default(autoincrement())
  accountId     String
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status        JobStatus        @default(OPEN)
  category      MaterialCategory @default(OTHER)
  material      String
  quantity      Float
  unit          String
  siteAddress   String
  docketNumber  String?
  notes         String?
  expectedDate  DateTime?
  createdAt     DateTime         @default(now())
  completedAt   DateTime?

  deliveries Delivery[]
}

model Delivery {
  id                String         @id @default(cuid())
  jobId             String
  job               Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status            DeliveryStatus @default(ORDERED)
  quantity          Float
  deliveredQuantity Float?
  vehicleReg        String?
  driverId          String?
  driver            User?          @relation("DriverDeliveries", fields: [driverId], references: [id], onDelete: SetNull)
  orderedAt         DateTime       @default(now())
  dispatchedAt      DateTime?
  onSiteAt          DateTime?
  unloadingAt       DateTime?
  deliveredAt       DateTime?
  podSignedBy       String?
  podPhotoUrl       String?
  podNote           String?
  createdAt         DateTime       @default(now())

  events    DeliveryStatusEvent[]
  positions DeliveryPosition[]
}

model DeliveryStatusEvent {
  id         String         @id @default(cuid())
  deliveryId String
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     DeliveryStatus
  note       String?
  createdAt  DateTime       @default(now())
}

model DeliveryPosition {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())
}
